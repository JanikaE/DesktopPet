<Window x:Class="DesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopPet"
        Width="256" Height="384"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Grid MouseLeftButtonDown="PetMouseLeftButtonDown"
        MouseLeftButtonUp="PetMouseLeftButtonUp"
        MouseMove="PetMouseMove"
        MouseRightButtonUp="PetMouseRightButtonUp">
    <Image x:Name="PetImage" Stretch="Uniform" SnapsToDevicePixels="True" />
    <Grid.ContextMenu>
      <ContextMenu>
        <MenuItem x:Name="TopmostMenuItem" Header="置顶" IsCheckable="True" IsChecked="True" Click="ToggleTopmost" />
        <MenuItem Header="设置" Click="OpenSettings" />
        <Separator />
        <MenuItem Header="退出" Click="ExitApplication" />
      </ContextMenu>
    </Grid.ContextMenu>
  </Grid>
</Window>
