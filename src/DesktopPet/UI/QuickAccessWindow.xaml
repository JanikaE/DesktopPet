<Window x:Class="DesktopPet.UI.QuickAccessWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:DesktopPet.UI" Width="300" Height="384" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources><ui:LauncherIconConverter x:Key="LauncherIcon"/></Window.Resources>
  <Border Margin="8" Padding="10" CornerRadius="20" Background="#E8FAF7FC" BorderBrush="#D6C8E4" BorderThickness="1"><Border.Effect><DropShadowEffect Color="#766589" BlurRadius="18" ShadowDepth="3" Opacity="0.3"/></Border.Effect>
    <TabControl><TabItem Header="待办"><Grid Margin="4,10,4,4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox x:Name="TodoTitleBox" ToolTip="输入待办，点击输入框外自动添加" LostKeyboardFocus="TodoTitleLostFocus"/><ListBox x:Name="TodoList" Grid.Row="1" Margin="0,8,0,0"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="4"><Button DockPanel.Dock="Right" Width="42" Padding="3" Content="删除" Tag="{Binding}" Click="DeleteTodo"/><CheckBox IsChecked="{Binding IsCompleted}" Tag="{Binding}" Checked="TodoChanged" Unchecked="TodoChanged"><TextBlock Text="{Binding Title}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#4B4358"/><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Foreground" Value="#9A92A3"/><Setter Property="TextDecorations" Value="Strikethrough"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></CheckBox></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
      <TabItem Header="快捷启动"><ListBox x:Name="LauncherList" Margin="4,10,4,4" Background="#60FFFFFF" BorderThickness="0" AllowDrop="True" PreviewMouseLeftButtonDown="LauncherPreviewMouseLeftButtonDown" PreviewMouseMove="LauncherPreviewMouseMove" Drop="LauncherDrop" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Padding" Value="0"/></Style></ListBox.ItemContainerStyle><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" VerticalAlignment="Top"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Button Height="88" Margin="3" Padding="4" VerticalAlignment="Top" Tag="{Binding}" Click="Launch"><StackPanel><Image Width="48" Height="48" Source="{Binding TargetPath,Converter={StaticResource LauncherIcon}}"/><TextBlock Margin="0,5,0,0" Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel></Button></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem></TabControl>
  </Border>
</Window>
