<Window x:Class="DesktopPet.UI.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:DesktopPet.UI" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="DesktopPet 设置" Width="552" Height="660" WindowStyle="None" AllowsTransparency="False" Background="#FAF8FC" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" PreviewMouseDown="WindowPreviewMouseDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="22" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ui:LauncherIconConverter x:Key="LauncherIcon"/>
    </Window.Resources>
    <Border Padding="18" CornerRadius="22" Background="#FAF8FC" BorderBrush="#D9CDE8" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="DragSettingsWindow">
                <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#65567F" Text="DesktopPet 设置"/>
                <Button Width="34" Height="30" HorizontalAlignment="Right" Padding="0" FontSize="18" Content="×" Click="CloseSettingsWindow"/>
            </Grid>
            <TabControl Grid.Row="1">
                <TabItem Header="常规">
                    <Border Margin="6,12,6,6" Padding="20" CornerRadius="15" Background="#AFFFFFFF">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="桌宠行为"/>
                                <CheckBox x:Name="TopmostCheckBox" Margin="0,22,0,0" Content="始终置顶" Checked="TopmostChanged" Unchecked="TopmostChanged"/>
                                <TextBlock Margin="0,24,0,7" FontWeight="SemiBold" Text="显示 / 隐藏快捷键"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Width="58" Margin="8,0,0,0" Content="清除" Click="ClearVisibilityHotkey"/>
                                    <TextBox x:Name="VisibilityHotkeyBox" IsReadOnly="True" ToolTip="点击后按下包含 Ctrl、Alt、Shift 或 Win 的组合键" PreviewKeyDown="CaptureVisibilityHotkey"/>
                                </DockPanel>
                                <TextBlock Margin="0,7,0,0" Foreground="#897F96" FontSize="12" Text="点击输入框，然后直接按下组合键；快捷键在其他程序中也可使用。"/>
                                <TextBlock Margin="0,20,0,7" FontWeight="SemiBold" Text="打开 / 关闭键盘统计快捷键"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Width="58" Margin="8,0,0,0" Content="清除" Click="ClearKeyboardStatisticsHotkey"/>
                                    <TextBox x:Name="KeyboardStatisticsHotkeyBox" IsReadOnly="True" ToolTip="点击后按下包含 Ctrl、Alt、Shift 或 Win 的组合键" PreviewKeyDown="CaptureKeyboardStatisticsHotkey"/>
                                </DockPanel>
                                <TextBlock Margin="0,20,0,7" FontWeight="SemiBold" Text="打开 / 关闭鼠标统计快捷键"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Width="58" Margin="8,0,0,0" Content="清除" Click="ClearMouseStatisticsHotkey"/>
                                    <TextBox x:Name="MouseStatisticsHotkeyBox" IsReadOnly="True" ToolTip="点击后按下包含 Ctrl、Alt、Shift 或 Win 的组合键" PreviewKeyDown="CaptureMouseStatisticsHotkey"/>
                                </DockPanel>
                                <TextBlock Margin="0,7,0,0" Foreground="#897F96" FontSize="12" Text="再次按下快捷键可关闭对应的统计窗口。"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>
                <TabItem x:Name="LauncherTab" Header="快捷启动">
                    <Grid Margin="6,12,6,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <WrapPanel>
                            <Button Margin="0,0,8,0" Content="选择文件夹" Click="BrowseFolder"/>
                            <Button Content="选择文件" Click="BrowseFile"/>
                        </WrapPanel>
                        <ListBox x:Name="LauncherList" Grid.Row="1" Margin="0,12,0,0" AllowDrop="True" PreviewMouseLeftButtonDown="LauncherPreviewMouseLeftButtonDown" PreviewMouseMove="LauncherPreviewMouseMove" Drop="LauncherDrop" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="98" Margin="4" Padding="5" Background="#BFFFFFFF" BorderBrush="#DDD3E9" BorderThickness="1" CornerRadius="12" MouseLeftButtonDown="CardMouseLeftButtonDown">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="删除" Click="DeleteLauncher"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Image Width="48" Height="48" HorizontalAlignment="Center" Visibility="Visible" Source="{Binding TargetPath,Converter={StaticResource LauncherIcon}}"/>
                                            <Grid Grid.Row="1" Margin="0,4,0,0" Height="34" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" MaxHeight="34" ToolTip="{Binding TargetPath}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style></TextBlock>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" KeyDown="LauncherNameKeyDown" LostFocus="LauncherNameLostFocus" ToolTip="{Binding TargetPath}" VerticalContentAlignment="Center">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                            <Setter Property="TextAlignment" Value="Center"/>
                                                            <Setter Property="Padding" Value="4,2"/>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
                <TabItem Header="OneDrive 同步">
                    <Border Margin="6,12,6,6" Padding="20" CornerRadius="15" Background="#AFFFFFFF">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="待办跨设备同步"/>
                                <TextBlock Margin="0,10,0,0" Foreground="#6F667A" TextWrapping="Wrap" Text="依赖本机 OneDrive 客户端。DesktopPet 只读写所选同步文件夹，不需要登录授权；云端上传状态请以系统托盘中的 OneDrive 为准。"/>
                                <TextBlock Margin="0,22,0,7" FontWeight="SemiBold" Text="同步目录"/>
                                <TextBox x:Name="TodoSyncDirectoryBox" IsReadOnly="True" TextWrapping="Wrap" ToolTip="DesktopPet 待办副本所在目录"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="EnableTodoSyncButton" Width="104" Margin="0,0,8,8" Content="启用同步" Click="EnableTodoSync"/>
                                    <Button x:Name="ChooseTodoSyncDirectoryButton" Width="112" Margin="0,0,8,8" Content="选择其他目录" Click="ChooseTodoSyncDirectory"/>
                                    <Button x:Name="SyncTodosNowButton" Width="96" Margin="0,0,8,8" Content="立即扫描" Click="SyncTodosNow"/>
                                    <Button x:Name="OpenTodoSyncDirectoryButton" Width="104" Margin="0,0,8,8" Content="打开目录" Click="OpenTodoSyncDirectory"/>
                                    <Button x:Name="DisableTodoSyncButton" Width="96" Margin="0,0,8,8" Content="停用同步" Click="DisableTodoSync"/>
                                </WrapPanel>
                                <Border Margin="0,16,0,0" Padding="14" CornerRadius="12" Background="#F1ECF7" BorderBrush="#DDD3E9" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="当前状态"/>
                                        <TextBlock x:Name="TodoSyncStatusText" Margin="0,7,0,0" Foreground="#65567F" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TodoSyncLastTimeText" Margin="0,5,0,0" Foreground="#897F96" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Margin="0,16,0,0" Foreground="#897F96" FontSize="12" TextWrapping="Wrap" Text="首次启用时会无损合并本地与同步目录中的待办。同标题待办不会自动去重；停用同步不会删除任何本地或 OneDrive 文件。"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
