<Window x:Class="DesktopPet.UI.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:DesktopPet.UI" Title="DesktopPet 设置" Width="580" Height="540" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources><ui:LauncherIconConverter x:Key="LauncherIcon"/></Window.Resources>
  <Border Margin="14" Padding="18" CornerRadius="22" Background="#F5FAF8FD" BorderBrush="#D9CDE8" BorderThickness="1"><Border.Effect><DropShadowEffect Color="#806B7A" BlurRadius="24" ShadowDepth="5" Opacity="0.28"/></Border.Effect>
    <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Background="Transparent" MouseLeftButtonDown="DragSettingsWindow"><TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#65567F" Text="DesktopPet 设置"/><Button Width="34" Height="30" HorizontalAlignment="Right" Padding="0" FontSize="18" Content="×" Click="CloseSettingsWindow"/></Grid>
      <TabControl Grid.Row="1">
        <TabItem Header="常规"><Border Margin="6,12,6,6" Padding="20" CornerRadius="15" Background="#AFFFFFFF"><StackPanel><TextBlock FontSize="16" FontWeight="SemiBold" Text="桌宠行为"/><CheckBox x:Name="TopmostCheckBox" Margin="0,22,0,0" Content="始终置顶" Checked="TopmostChanged" Unchecked="TopmostChanged"/></StackPanel></Border></TabItem>
        <TabItem Header="快捷启动"><Grid Margin="6,12,6,6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox x:Name="LauncherNameBox" ToolTip="名称（可选）"/><DockPanel Grid.Row="1" Margin="0,9,0,0"><Button DockPanel.Dock="Right" Width="82" Margin="8,0,0,0" Content="选择程序" Click="BrowseApplication"/><Button DockPanel.Dock="Right" Width="82" Margin="8,0,0,0" Content="选择文件夹" Click="BrowseFolder"/><TextBox x:Name="LauncherPathBox" ToolTip="程序或文件夹路径"/></DockPanel><Button Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right" Width="100" Content="添加快捷方式" Click="AddLauncher"/><ListBox x:Name="LauncherList" Grid.Row="3" Margin="0,12,0,0" MouseDoubleClick="LaunchSelected" AllowDrop="True" PreviewMouseLeftButtonDown="LauncherPreviewMouseLeftButtonDown" PreviewMouseMove="LauncherPreviewMouseMove" Drop="LauncherDrop" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Padding" Value="0"/></Style></ListBox.ItemContainerStyle><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" VerticalAlignment="Top"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Height="112" Margin="4" Padding="5" Background="#BFFFFFFF" BorderBrush="#DDD3E9" BorderThickness="1" CornerRadius="12"><StackPanel><Image Width="48" Height="48" Source="{Binding TargetPath,Converter={StaticResource LauncherIcon}}"/><TextBlock Margin="0,5,0,0" Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Margin="0,6,0,0" Height="25" Padding="4,1" Content="删除" Tag="{Binding}" Click="DeleteLauncher"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
      </TabControl>
    </Grid>
  </Border>
</Window>
