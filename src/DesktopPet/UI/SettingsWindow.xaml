<Window x:Class="DesktopPet.UI.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:DesktopPet.UI" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="DesktopPet 设置" Width="552" Height="660" WindowStyle="None" AllowsTransparency="False" Background="#FAF8FC" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" CornerRadius="22" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources><ui:LauncherIconConverter x:Key="LauncherIcon"/></Window.Resources>
  <Border Padding="18" CornerRadius="22" Background="#FAF8FC" BorderBrush="#D9CDE8" BorderThickness="1">
    <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Background="Transparent" MouseLeftButtonDown="DragSettingsWindow"><TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#65567F" Text="DesktopPet 设置"/><Button Width="34" Height="30" HorizontalAlignment="Right" Padding="0" FontSize="18" Content="×" Click="CloseSettingsWindow"/></Grid>
      <TabControl Grid.Row="1">
        <TabItem Header="常规"><Border Margin="6,12,6,6" Padding="20" CornerRadius="15" Background="#AFFFFFFF"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock FontSize="16" FontWeight="SemiBold" Text="桌宠行为"/><CheckBox x:Name="TopmostCheckBox" Margin="0,22,0,0" Content="始终置顶" Checked="TopmostChanged" Unchecked="TopmostChanged"/><TextBlock Margin="0,24,0,7" FontWeight="SemiBold" Text="显示 / 隐藏快捷键"/><DockPanel><Button DockPanel.Dock="Right" Width="58" Margin="8,0,0,0" Content="清除" Click="ClearVisibilityHotkey"/><TextBox x:Name="VisibilityHotkeyBox" IsReadOnly="True" ToolTip="点击后按下包含 Ctrl、Alt、Shift 或 Win 的组合键" PreviewKeyDown="CaptureVisibilityHotkey"/></DockPanel><TextBlock Margin="0,7,0,0" Foreground="#897F96" FontSize="12" Text="点击输入框，然后直接按下组合键；快捷键在其他程序中也可使用。"/><TextBlock Margin="0,20,0,7" FontWeight="SemiBold" Text="打开 / 关闭键盘统计快捷键"/><DockPanel><Button DockPanel.Dock="Right" Width="58" Margin="8,0,0,0" Content="清除" Click="ClearKeyboardStatisticsHotkey"/><TextBox x:Name="KeyboardStatisticsHotkeyBox" IsReadOnly="True" ToolTip="点击后按下包含 Ctrl、Alt、Shift 或 Win 的组合键" PreviewKeyDown="CaptureKeyboardStatisticsHotkey"/></DockPanel><TextBlock Margin="0,20,0,7" FontWeight="SemiBold" Text="打开 / 关闭鼠标统计快捷键"/><DockPanel><Button DockPanel.Dock="Right" Width="58" Margin="8,0,0,0" Content="清除" Click="ClearMouseStatisticsHotkey"/><TextBox x:Name="MouseStatisticsHotkeyBox" IsReadOnly="True" ToolTip="点击后按下包含 Ctrl、Alt、Shift 或 Win 的组合键" PreviewKeyDown="CaptureMouseStatisticsHotkey"/></DockPanel><TextBlock Margin="0,7,0,0" Foreground="#897F96" FontSize="12" Text="再次按下快捷键可关闭对应的统计窗口。"/></StackPanel></ScrollViewer></Border></TabItem>
        <TabItem Header="快捷启动"><Grid Margin="6,12,6,6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox x:Name="LauncherNameBox" ToolTip="名称（可选）"/><DockPanel Grid.Row="1" Margin="0,9,0,0"><Button DockPanel.Dock="Right" Width="82" Margin="8,0,0,0" Content="选择程序" Click="BrowseApplication"/><Button DockPanel.Dock="Right" Width="82" Margin="8,0,0,0" Content="选择文件夹" Click="BrowseFolder"/><TextBox x:Name="LauncherPathBox" ToolTip="程序或文件夹路径"/></DockPanel><Button Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right" Width="100" Content="添加快捷方式" Click="AddLauncher"/><ListBox x:Name="LauncherList" Grid.Row="3" Margin="0,12,0,0" MouseDoubleClick="LaunchSelected" AllowDrop="True" PreviewMouseLeftButtonDown="LauncherPreviewMouseLeftButtonDown" PreviewMouseMove="LauncherPreviewMouseMove" Drop="LauncherDrop" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Padding" Value="0"/></Style></ListBox.ItemContainerStyle><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" VerticalAlignment="Top"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Height="112" Margin="4" Padding="5" Background="#BFFFFFFF" BorderBrush="#DDD3E9" BorderThickness="1" CornerRadius="12"><StackPanel><Image Width="48" Height="48" Source="{Binding TargetPath,Converter={StaticResource LauncherIcon}}"/><TextBlock Margin="0,5,0,0" Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Margin="0,6,0,0" Height="25" Padding="4,1" Content="删除" Tag="{Binding}" Click="DeleteLauncher"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
      </TabControl>
    </Grid>
  </Border>
</Window>
