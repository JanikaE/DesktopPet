<Window x:Class="DesktopPet.UI.KeyboardStatisticsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="键盘统计" Width="811" Height="314" WindowStyle="None" AllowsTransparency="False" Background="#FAF7FC" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" CornerRadius="20" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources><Style TargetType="{x:Type primitives:CalendarDayButton}"><EventSetter Event="Loaded" Handler="CalendarDayLoaded"/></Style></Window.Resources>
  <Border Padding="12" CornerRadius="20" Background="#FAF7FC" BorderBrush="#D6C8E4" BorderThickness="1">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="#65567F" Text="键盘统计"/><TextBlock x:Name="TotalCountText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#897F96"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><ComboBox x:Name="RangeBox" Width="100" SelectionChanged="RangeChanged"><ComboBoxItem Content="不限时间"/><ComboBoxItem Content="当天"/><ComboBoxItem Content="近一周"/><ComboBoxItem Content="近一个月"/><ComboBoxItem Content="自定义"/></ComboBox><StackPanel Margin="6,0,0,0" Orientation="Horizontal"><DatePicker x:Name="StartDatePicker" Width="112" SelectedDateChanged="SelectedDateChanged"/><TextBlock Margin="5,0" VerticalAlignment="Center" Text="至"/><DatePicker x:Name="EndDatePicker" Width="112" SelectedDateChanged="SelectedDateChanged"/><Button Margin="6,0,0,0" Padding="7,4" Content="应用" Click="ApplyCustomRange"/></StackPanel></StackPanel></Grid>
      <Grid x:Name="KeyboardGrid" Grid.Row="1" Margin="0,7,0,0"/>
    </Grid>
  </Border>
