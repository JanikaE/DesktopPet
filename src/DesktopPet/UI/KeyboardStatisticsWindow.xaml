<Window x:Class="DesktopPet.UI.KeyboardStatisticsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="键盘统计" Width="811" Height="314" WindowStyle="None" AllowsTransparency="False" Background="#FAF7FC" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="20" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="{x:Type primitives:CalendarDayButton}">
            <EventSetter Event="Loaded" Handler="CalendarDayLoaded"/>
        </Style>
    </Window.Resources>
    <Border Padding="12" CornerRadius="20" Background="#FAF7FC" BorderBrush="#D6C8E4" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="#65567F" Text="键盘统计"/>
                    <TextBlock x:Name="TotalCountText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#897F96"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ComboBox x:Name="RangeBox" Width="88" SelectionChanged="RangeChanged">
                        <ComboBoxItem Content="不限时间"/>
                        <ComboBoxItem Content="当天"/>
                        <ComboBoxItem Content="近一周"/>
                        <ComboBoxItem Content="近一个月"/>
                        <ComboBoxItem Content="自定义"/>
                    </ComboBox>
                    <Button x:Name="RangeButton" Width="210" Margin="6,0,0,0" Padding="9,5" HorizontalContentAlignment="Center" ToolTip="点击选择开始日期和结束日期" Content="全部时间" Click="ToggleRangePopup"/>
                    <Popup x:Name="RangePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=RangeButton}" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                        <Border Margin="0,4,0,0" Padding="6" CornerRadius="12" Background="#FCFAFF" BorderBrush="#D6C8E4" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18" Color="#65567F"/>
                            </Border.Effect>
                            <Calendar x:Name="RangeCalendar" SelectionMode="MultipleRange" DisplayDateChanged="CalendarDisplayDateChanged" SelectedDatesChanged="CalendarSelectedDatesChanged"/>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
            <Grid x:Name="KeyboardGrid" Grid.Row="1" Margin="0,7,0,0"/>
        </Grid>
    </Border>
</Window>
