<Window x:Class="DesktopPet.UI.PetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义桌宠" Width="510" Height="590"
        WindowStyle="None" AllowsTransparency="False" Background="#FAF8FC"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Padding="22" CornerRadius="20" Background="#FAF8FC" BorderBrush="#D9CDE8" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="DragEditorWindow">
                <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#65567F" Text="添加自定义桌宠"/>
                <Button Width="34" Height="30" HorizontalAlignment="Right" Padding="0" FontSize="18" Content="×" Click="Cancel"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="2,10,8,12">
                    <TextBlock FontWeight="SemiBold" Text="名称"/>
                    <TextBox x:Name="NameBox" Margin="0,7,0,18" MaxLength="60"/>
                    <TextBlock Foreground="#6F667A" TextWrapping="Wrap" Text="Idle 为必填；Click 和 Dragging 留空时会自动使用 Idle。推荐使用相同比例和角色位置的透明 PNG。"/>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                        <Image x:Name="IdlePreview" Width="64" Height="96" Stretch="Uniform"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Text="Idle（必填）"/><TextBlock x:Name="IdlePathText" Margin="0,6,8,0" Foreground="#897F96" TextTrimming="CharacterEllipsis"/></StackPanel>
                        <Button Grid.Column="2" VerticalAlignment="Center" Content="选择" Tag="Idle" Click="ChoosePng"/>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                        <Image x:Name="ClickPreview" Width="64" Height="96" Stretch="Uniform"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Text="Click（可选）"/><TextBlock x:Name="ClickPathText" Margin="0,6,8,0" Foreground="#897F96" TextTrimming="CharacterEllipsis"/></StackPanel>
                        <Button Grid.Column="2" VerticalAlignment="Center" Content="选择" Tag="Click" Click="ChoosePng"/>
                        <Button Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center" Content="清除" Tag="Click" Click="ClearPng"/>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                        <Image x:Name="DraggingPreview" Width="64" Height="96" Stretch="Uniform"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Text="Dragging（可选）"/><TextBlock x:Name="DraggingPathText" Margin="0,6,8,0" Foreground="#897F96" TextTrimming="CharacterEllipsis"/></StackPanel>
                        <Button Grid.Column="2" VerticalAlignment="Center" Content="选择" Tag="Dragging" Click="ChoosePng"/>
                        <Button Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center" Content="清除" Tag="Dragging" Click="ClearPng"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="86" Margin="0,0,10,0" Content="取消" Click="Cancel"/>
                <Button Width="96" Content="保存" Click="Save"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
