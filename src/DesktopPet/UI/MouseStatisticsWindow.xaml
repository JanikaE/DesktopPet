<Window x:Class="DesktopPet.UI.MouseStatisticsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="鼠标统计" Width="760" Height="384" SizeToContent="Manual" WindowStyle="None" AllowsTransparency="False" Background="#FAF7FC" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="20" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="{x:Type primitives:CalendarDayButton}">
            <EventSetter Event="Loaded" Handler="CalendarDayLoaded"/>
        </Style>
    </Window.Resources>
    <Border Padding="12" CornerRadius="20" Background="#FAF7FC" BorderBrush="#D6C8E4" BorderThickness="1">
        <Grid x:Name="StatisticsLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="#65567F" Text="鼠标统计"/>
                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="MoveText" Foreground="#897F96"/>
                    <TextBlock x:Name="DoubleClickText" Foreground="#897F96"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="RangeBox" Width="88" VerticalAlignment="Center" SelectionChanged="RangeChanged">
                        <ComboBoxItem Content="不限时间"/>
                        <ComboBoxItem Content="当天"/>
                        <ComboBoxItem Content="近一周"/>
                        <ComboBoxItem Content="近一个月"/>
                        <ComboBoxItem Content="自定义"/>
                    </ComboBox>
                    <Button x:Name="RangeButton" Width="210" Margin="6,0,0,0" Padding="9,5" VerticalAlignment="Center" HorizontalContentAlignment="Center" ToolTip="点击选择开始日期和结束日期" Content="全部时间" Click="ToggleRangePopup"/>
                    <Popup x:Name="RangePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=RangeButton}" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                        <Border Margin="0,4,0,0" Padding="6" CornerRadius="12" Background="#FCFAFF" BorderBrush="#D6C8E4" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18" Color="#65567F"/>
                            </Border.Effect>
                            <Calendar x:Name="RangeCalendar" SelectionMode="MultipleRange" DisplayDateChanged="CalendarDisplayDateChanged" SelectedDatesChanged="CalendarSelectedDatesChanged"/>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
            <Border x:Name="MapHost" Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Background="#F1ECF8" BorderBrush="#D6C8E4" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Image x:Name="HeatmapImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Canvas x:Name="MarkerCanvas" ClipToBounds="True"/>
                    <Canvas x:Name="TrailCanvas" ClipToBounds="True" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <StackPanel x:Name="LegendPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
