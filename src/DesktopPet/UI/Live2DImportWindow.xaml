<Window x:Class="DesktopPet.UI.Live2DImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入 Live2D 桌宠" Width="540" Height="690"
        WindowStyle="None" AllowsTransparency="False" Background="#FAF8FC"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Padding="22" CornerRadius="20" Background="#FAF8FC" BorderBrush="#D9CDE8" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="DragEditorWindow">
                <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#65567F" Text="导入 Live2D 桌宠"/>
                <Button Width="34" Height="30" HorizontalAlignment="Right" Padding="0" FontSize="18" Content="×" Click="Cancel"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="2,10,8,12">
                    <TextBlock FontWeight="SemiBold" Text="名称"/>
                    <TextBox x:Name="NameBox" Margin="0,7,0,18" MaxLength="60" Text="Live2D 桌宠"/>

                    <TextBlock FontWeight="SemiBold" Text="模型文件"/>
                    <DockPanel Margin="0,7,0,0">
                        <Button DockPanel.Dock="Right" Width="86" Margin="8,0,0,0" Content="选择" Click="ChooseModel"/>
                        <TextBox x:Name="ModelPathBox" IsReadOnly="True" Text="尚未选择"/>
                    </DockPanel>
                    <TextBlock x:Name="ModelSummaryText" Margin="0,7,0,0" Foreground="#897F96" FontSize="12" TextWrapping="Wrap"
                               Text="请选择 Cubism Editor 导出的 model3.json。也可选择 moc3/cmo3 以查看对应提示。"/>

                    <TextBlock Margin="0,20,0,0" FontWeight="SemiBold" Text="动作映射"/>
                    <TextBlock Margin="0,6,0,10" Foreground="#6F667A" FontSize="12" TextWrapping="Wrap"
                               Text="动作组来自 model3.json；留空时保持模型默认的眨眼、呼吸和物理效果。"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Idle"/>
                        <ComboBox x:Name="IdleMotionBox" Grid.Column="1" Margin="0,4"/>
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Click"/>
                        <ComboBox x:Name="ClickMotionBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Dragging"/>
                        <ComboBox x:Name="DraggingMotionBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                    </Grid>

                    <TextBlock Margin="0,20,0,0" FontWeight="SemiBold" Text="布局"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="缩放"/>
                        <TextBox x:Name="ScaleBox" Grid.Column="1" Margin="0,4" Text="1.0" ToolTip="0.1 到 5.0"/>
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="水平偏移"/>
                        <TextBox x:Name="OffsetXBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Text="0" ToolTip="-2 到 2"/>
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="垂直偏移"/>
                        <TextBox x:Name="OffsetYBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Text="0" ToolTip="-2 到 2"/>
                    </Grid>

                    <TextBlock Margin="0,20,0,0" FontWeight="SemiBold" Text="鼠标追踪"/>
                    <DockPanel Margin="0,7,0,0">
                        <Button DockPanel.Dock="Right" Width="138" Content="鼠标追踪参数配置" Click="ConfigurePointerTracking"/>
                        <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#6F667A" FontSize="12" TextWrapping="Wrap"
                                   Text="按 Cubism Viewer 的参数、影响度、反转和类型驱动模型。"/>
                    </DockPanel>

                    <Border Margin="0,20,0,0" Padding="12" CornerRadius="10" Background="#F1ECF7" BorderBrush="#DDD3E9" BorderThickness="1">
                        <TextBlock Foreground="#65567F" FontSize="12" TextWrapping="Wrap"
                                   Text="模型会完整复制到 DesktopPet 的本地应用数据目录，不依赖原始文件。请确认你拥有该模型的使用许可。"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="86" Margin="0,0,10,0" Content="取消" Click="Cancel"/>
                <Button Width="96" Content="导入" Click="Save"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
