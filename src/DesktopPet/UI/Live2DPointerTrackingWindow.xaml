<Window x:Class="DesktopPet.UI.Live2DPointerTrackingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鼠标跟踪设置" Width="650" Height="600"
        WindowStyle="None" AllowsTransparency="False" Background="#FAF8FC"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Padding="18" CornerRadius="18" Background="#FAF8FC" BorderBrush="#D9CDE8" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="DragEditorWindow">
                <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#65567F" Text="鼠标跟踪设置"/>
                <Button Width="34" Height="30" HorizontalAlignment="Right" Padding="0" FontSize="18" Content="×" Click="Cancel"/>
            </Grid>

            <DataGrid x:Name="TrackingGrid" Grid.Row="1" Margin="0,8,0,12"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False" CanUserResizeRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="All" RowHeaderWidth="0" SelectionUnit="CellOrRowHeader">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="112" Header="参数名称" Binding="{Binding Name}" IsReadOnly="True"/>
                    <DataGridTextColumn Width="150" Header="参数 ID" Binding="{Binding ParameterId}" IsReadOnly="True"/>
                    <DataGridTextColumn Width="90" Header="影响度(%)" Binding="{Binding ImpactText, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridCheckBoxColumn Width="62" Header="反转" Binding="{Binding Reflect, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridComboBoxColumn x:Name="SourceColumn" Width="*" Header="类型"
                                            SelectedValueBinding="{Binding Source, UpdateSourceTrigger=PropertyChanged}"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="2">
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <Button Width="112" Margin="0,0,8,0" Content="还原默认设置" Click="RestoreDefaults"/>
                    <Button Width="102" Content="全部未设置" Click="ClearAll"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="86" Margin="0,0,10,0" Content="取消" Click="Cancel"/>
                    <Button Width="96" Content="确定" Click="Save"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
