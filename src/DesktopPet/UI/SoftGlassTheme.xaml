<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="AccentBrush" Color="#8D7AB8"/>
  <SolidColorBrush x:Key="AccentLightBrush" Color="#E9E3F4"/>
  <SolidColorBrush x:Key="TextBrush" Color="#4B4358"/>
  <SolidColorBrush x:Key="MutedTextBrush" Color="#897F96"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#EFFFFFFF"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="#D8CEE7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="{StaticResource AccentLightBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="#CDBFE0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,5"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DDD2ED"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#CBBCE1"/></Trigger></Style.Triggers></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#70FFFFFF"/><Setter Property="BorderBrush" Value="#D8CEE7"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/><Setter Property="Background" Value="#80FFFFFF"/><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="2,0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="Background" Value="{StaticResource AccentLightBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers></Style>
</ResourceDictionary>
